---
interface Props {
  slug: string;
  title: string;
  teaser: string;
  image?: string;
  formattedDate: string;
  isFirst?: boolean;
}
const { slug, title, teaser, image, formattedDate, isFirst = false } = Astro.props;
---

<article class:list={["flex flex-col gap-4 py-6 sm:flex-row sm:items-start sm:gap-6", { "pt-0": isFirst }]}>
  <div class="flex items-start justify-between gap-4 sm:contents">
    <div class="w-28 shrink-0 sm:w-36">
      {image ? (
        <img
          src={image}
          alt=""
          class="aspect-square w-full border-2 border-black object-cover"
        />
      ) : (
        <div class="flex aspect-square w-full items-center justify-center border-2 border-black bg-black/5">
          <p class="px-2 text-center font-meta text-[0.6rem] font-bold uppercase tracking-wide text-black/40">
            Image
          </p>
        </div>
      )}
    </div>
    <p class="shrink-0 text-right font-meta text-xs font-bold uppercase tracking-[0.15em] text-black/60 sm:order-3">
      {formattedDate}
    </p>
  </div>
  <div class="flex-1">
    <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight sm:text-3xl">
      {title}
    </h3>
    <p class="mt-2 font-body text-lg leading-snug">
      {teaser}
    </p>
    <a
      href={`/blog/${slug}`}
      class="mt-3 inline-block border-b-2 border-black font-meta text-sm font-bold uppercase tracking-wide"
    >
      Read More &rarr;
    </a>
  </div>
</article>
