---
import { siteConfig, isPlaceholder } from "../config/site.config";
import { getGithubContributionCount } from "../lib/github";

const showPlaceholder = isPlaceholder(siteConfig.githubUsername);
const chartUrl = `https://ghchart.rshah.org/000000/${siteConfig.githubUsername}`;
const contributionCount = showPlaceholder ? null : await getGithubContributionCount(siteConfig.githubUsername);
// Deterministic pseudo-random fill so the placeholder grid looks like a
// contribution graph rather than a uniform block.
const placeholderCells = Array.from({ length: 17 * 7 }, (_, i) => (i * 37) % 5);
---

<div class="border-4 border-black" data-github-graph>
  <div class="flex items-center justify-between gap-4 bg-black px-4 py-3 text-white sm:px-6 sm:py-4">
    <div>
      <h3 class="font-headline text-xl uppercase leading-none tracking-tight sm:text-2xl">
        GitHub
      </h3>
      {contributionCount !== null && (
        <p class="mt-1 font-meta text-xs font-bold uppercase tracking-wide text-white/70">
          {contributionCount.toLocaleString()} contributions · last year
        </p>
      )}
    </div>
    <a
      href={siteConfig.githubUrl}
      class="shrink-0 border-2 border-white px-2.5 py-1.5 font-meta text-xs font-bold uppercase tracking-wide hover:bg-white hover:text-black sm:px-3"
    >
      @{siteConfig.githubUsername}
    </a>
  </div>

  {showPlaceholder ? (
    <div class="flex flex-col gap-4 p-6">
      <div class="grid grid-flow-col grid-rows-7 gap-1">
        {placeholderCells.map((level) => (
          <span
            class="h-4 w-4 border border-black"
            style={`background-color: rgba(0,0,0,${level * 0.15});`}
          />
        ))}
      </div>
      <p class="font-meta text-sm font-bold uppercase tracking-wide text-black/60">
        GitHub activity will appear here — add a GitHub username in{" "}
        <code class="font-mono">site.config.ts</code> to go live.
      </p>
    </div>
  ) : (
    <div class="aspect-[663/130]">
      <img
        src={chartUrl}
        alt={`${siteConfig.githubUsername}'s GitHub contribution graph`}
        loading="lazy"
        class="h-full w-full object-fill grayscale contrast-125"
        onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
      />
      <p class="hidden p-6 font-meta text-sm font-bold uppercase tracking-wide text-black/60">
        Couldn't load the GitHub contribution graph right now.
      </p>
    </div>
  )}
</div>
