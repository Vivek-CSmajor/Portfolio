---
import { existsSync } from "node:fs";
import path from "node:path";
interface Props { slug: string; class?: string; }
const { slug, class: className = "" } = Astro.props;
const extension = existsSync(path.join(process.cwd(), "public/icons", `${slug}.svg`)) ? "svg" : "png";
---
<img src={`/icons/${slug}.${extension}`} width="32" height="32" alt="" aria-hidden="true" loading="lazy" class={`skill-logo ${className}`} />
