---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About — Vivek Pandey"
  description="Education background for Vivek Pandey, backend developer and CS undergrad at Amity University, Lucknow."
>
  <div class="mx-auto max-w-3xl px-6 py-8 sm:px-10">
    <a
      href="/"
      class="font-meta text-sm font-bold uppercase tracking-[0.15em] hover:underline underline-offset-4"
    >
      &larr; Back to Home
    </a>

    <header class="mt-8 border-b-4 border-black pb-6">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">About</p>
      <h1 class="mt-2 font-headline text-5xl uppercase leading-[0.95] tracking-tight sm:text-7xl">
        Vivek Pandey
      </h1>
    </header>

    <section id="education" class="border-b-4 border-black py-10">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Education</p>
      <h2 class="mt-2 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
        B.Tech, Computer Science &amp; Engineering
      </h2>

      <div class="mt-6 border-2 border-black px-7 py-6">
        <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight">
          Amity University, Lucknow
        </h3>
        <p class="mt-1 font-meta text-xs font-bold tracking-[0.15em] uppercase text-black/60">
          2024 – 2028 (Expected) &middot; Lucknow, India
        </p>
        <p class="mt-4 font-body text-lg leading-snug">
          Bachelor of Technology in Computer Science &amp; Engineering.
          Currently maintaining a CGPA of 8.3, alongside part-time backend
          engineering internships and independent systems projects
          throughout the degree.
        </p>
        <p class="mt-4 font-meta text-sm font-bold uppercase tracking-wide text-black">
          CGPA 8.3 / 10
        </p>
      </div>
    </section>
  </div>
</Layout>
