---
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/posts";

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const formattedDate = new Date(post.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={`${post.title} — Vivek Pandey`} description={post.teaser}>
  <div class="mx-auto max-w-3xl px-6 py-8 sm:px-10">
    <a
      href="/#blog"
      class="font-meta text-sm font-bold uppercase tracking-[0.15em] hover:underline underline-offset-4"
    >
      &larr; Back to Home
    </a>

    <article class="mt-8">
      <p class="font-meta text-sm font-bold uppercase tracking-[0.2em] text-black/60">
        {formattedDate}
      </p>
      <h1 class="mt-3 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        {post.title}
      </h1>

      <div class="mt-10 space-y-6 border-t-4 border-black pt-8 font-body text-lg leading-snug">
        {post.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </article>
  </div>
</Layout>
