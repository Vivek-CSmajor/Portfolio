---
import Layout from "../layouts/Layout.astro";
import GithubGraph from "../components/GithubGraph.astro";
import LeetcodeGraph from "../components/LeetcodeGraph.astro";
import { siteConfig } from "../config/site.config";

const nav = [
  { label: "Work", href: "#work" },
  { label: "Skills", href: "#skills" },
  { label: "Blog", href: "#blog" },
  { label: "Contact", href: "#contact" },
];

const skills = [
  { label: "Languages", items: "Go, C++" },
  { label: "Frameworks", items: "Gin, Django, FastAPI" },
  { label: "Cloud / Infra", items: "AWS, CI/CD (GitHub Actions), Git" },
  { label: "Domain", items: "VoIP/SIP, REST APIs, Competitive Programming" },
  { label: "Data / BI", items: "Power BI, DAX, Power Query" },
];

const posts = [
  {
    title: "Go + Gin Patterns I Keep Reaching For",
    teaser: "Middleware, error handling, and project layout conventions that held up once things got messy at work.",
  },
  {
    title: "Building an Offline Judging Engine",
    teaser: "Architecture walkthrough of the sandboxed execution and ICPC-style scoring behind the coding assessment platform.",
  },
  {
    title: "What I Learned Building SIP/VoIP Integrations",
    teaser: "Notes from wiring up monitoring for real-time call infrastructure — the parts the RFC doesn't warn you about.",
  },
];
---

<Layout
  title="Vivek Pandey — Backend Developer"
  description="Backend developer working in Go and AWS on telephony, IoT, and voice AI systems."
>
  <div class="mx-auto max-w-6xl px-6 py-8 sm:px-10">
    <!-- Utility nav -->
    <nav class="flex flex-wrap items-center justify-between gap-4 border-b-2 border-black pb-4 font-meta text-sm font-bold tracking-[0.15em] uppercase">
      <span>Vol. 01 — Backend Developer</span>
      <ul class="flex flex-wrap items-center gap-7">
        {nav.map((item) => (
          <li><a href={item.href} class="hover:underline underline-offset-4">{item.label}</a></li>
        ))}
        <li>
          <a
            href={siteConfig.resumeUrl}
            class="border-2 border-black bg-black px-4 py-2 text-white hover:bg-white hover:text-black"
          >
            Résumé
          </a>
        </li>
      </ul>
    </nav>

    <!-- Masthead -->
    <header class="flex flex-col items-center pt-10 pb-0 text-center">
      <img src="/images/divider-ornament.png" alt="" class="mb-3 h-10 w-auto sm:h-14" />
      <h1 class="font-display text-6xl uppercase leading-[0.9] tracking-tight sm:text-8xl md:text-9xl">
        Vivek Pandey
      </h1>
    </header>

    <!-- Subhead banner -->
    <p class="mt-6 bg-black px-4 py-4 text-center font-headline text-lg uppercase tracking-wide text-white sm:text-2xl">
      Backend Developer — Go, AWS, and the Systems Underneath Telephony/VoIP
    </p>

    <!-- Double rule under masthead -->
    <div class="mt-6 border-t-4 border-black pt-1">
      <div class="border-t-2 border-black"></div>
    </div>

    <!-- Edition meta line -->
    <div class="flex items-center justify-between py-3 font-meta text-sm font-bold tracking-[0.15em] uppercase">
      <span>Portfolio Edition</span>
      <span>Est. 2024</span>
    </div>

    <!-- Lede -->
    <section class="border-t-4 border-black py-12">
      <p class="mx-auto max-w-2xl font-body text-2xl leading-snug first-letter:float-left first-letter:mr-2 first-letter:font-headline first-letter:text-8xl first-letter:leading-[0.75]">
        Currently a backend engineering intern at
        <span class="font-bold">Vobiz.ai</span>, working on core messaging
        infrastructure (SMS/RCS) and AI voice agent tooling for an AI-first
        telephony platform. CS undergrad at Amity University, Lucknow.
        <span class="font-bold">Language-agnostic by design</span> — Go is
        home base, but the interesting part is the systems, not the syntax.
      </p>

      <p class="mt-8 inline-block border-2 border-black px-4 py-2 font-meta text-sm font-bold tracking-[0.1em] uppercase">
        B.Tech CSE · Amity University, Lucknow · CGPA 8.3 · 2024–2028
      </p>
    </section>

    <!-- Featured work -->
    <section id="work" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Featured Work</p>
      <h2 class="mt-2 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        Internships &amp; Projects
      </h2>

      <div class="mt-10 grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
        <!-- Primary card: personal project, most space/detail -->
        <article class="lg:col-span-7 border-4 border-black">
          <div class="bg-black px-7 py-6 text-white">
            <p class="font-meta text-xs font-bold tracking-[0.2em] uppercase text-white/70">
              Personal Project — In Progress
            </p>
            <h3 class="mt-2 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-4xl">
              Offline Secure Coding Assessment Platform
            </h3>
          </div>
          <div class="space-y-5 px-7 py-7 font-body text-lg leading-snug">
            <p>
              A hybrid cloud + LAN exam platform for universities to run
              placement rounds and lab exams fully offline — a cloud control
              plane paired with a local judging engine.
            </p>
            <ul class="space-y-2">
              <li class="flex gap-3"><span class="font-headline">—</span> Sandboxed execution with ICPC-style scoring</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Local judging engine, no internet dependency mid-exam</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Lockdown-mode client — fullscreen and focus-switch enforcement</li>
            </ul>
            <a href="#" class="inline-block border-b-2 border-black font-meta text-base font-bold uppercase tracking-wide">
              View on GitHub &rarr;
            </a>
          </div>
        </article>

        <!-- Secondary cards: internships -->
        <div class="lg:col-span-5 flex flex-col gap-8">
          <article class="border-2 border-black px-7 py-6">
            <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight">
              Vobiz.ai — Software Development Intern
            </h3>
            <p class="mt-1 font-meta text-xs font-bold tracking-[0.15em] uppercase text-black/60">
              May 2026 – Present
            </p>
            <p class="mt-4 font-body text-base leading-snug">
              Building core SMS/RCS messaging features in Go for an AI-first
              telephony platform; shipped a regression-testing microservice
              with CI/CD via GitHub Actions; prototyped noise-cancellation
              integrations to improve speech-to-text accuracy for AI voice
              agents (ElevenLabs, Vapi).
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Go · AWS · CI/CD · VoIP
            </p>
          </article>

          <article class="border-2 border-black px-7 py-6">
            <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight">
              Devlume Software Solutions — Software Development Intern
            </h3>
            <p class="mt-1 font-meta text-xs font-bold tracking-[0.15em] uppercase text-black/60">
              Sep – Dec 2025
            </p>
            <p class="mt-4 font-body text-base leading-snug">
              Backend feature development in Python (Django, FastAPI) and Go
              across two products — real-time industrial sensor ingestion on
              AWS IoT for a factory platform, plus VoIP/SIP monitoring
              integrations.
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Python · Django · FastAPI · Go · AWS IoT · SIP
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Skills</p>
      <dl class="mt-6 grid grid-cols-1 border-2 border-black sm:grid-cols-2 lg:grid-cols-5">
        {skills.map((group, i) => (
          <div class={`px-6 py-5 ${i > 0 ? "border-t-2 sm:border-t-0 sm:border-l-2 border-black" : ""}`}>
            <dt class="inline-block bg-black px-2 py-1 font-meta text-xs font-bold tracking-[0.15em] uppercase text-white">
              {group.label}
            </dt>
            <dd class="mt-2 font-body text-lg font-medium leading-snug">{group.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- GitHub activity -->
    <section id="activity" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">GitHub Activity</p>
      <h2 class="mt-2 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        Contribution Graph
      </h2>
      <div class="mt-8">
        <GithubGraph />
      </div>

      <p class="mt-10 font-meta text-sm font-bold tracking-[0.2em] uppercase">LeetCode Stats</p>
      <div class="mt-4">
        <LeetcodeGraph />
      </div>
    </section>

    <!-- Blog preview -->
    <section id="blog" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">From the Blog</p>
      <div class="mt-6 divide-y-2 divide-black">
        {posts.map((post, i) => (
          <article class="flex gap-6 py-6 first:pt-0">
            <span class="font-display text-4xl leading-none text-black/30">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight sm:text-3xl">
                {post.title}
              </h3>
              <p class="mt-2 font-body text-lg leading-snug">
                {post.teaser}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t-4 border-black py-12 text-center">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Get in Touch</p>
      <h2 class="mx-auto mt-3 max-w-2xl font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
        Let's talk backend systems, telephony, or otherwise.
      </h2>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 font-meta text-sm font-bold uppercase tracking-wide">
        <a href={`mailto:${siteConfig.email}`} class="border-2 border-black px-5 py-2.5 hover:bg-black hover:text-white">Email</a>
        <a href={siteConfig.linkedinUrl} class="border-2 border-black px-5 py-2.5 hover:bg-black hover:text-white">LinkedIn</a>
        <a href={siteConfig.githubUrl} class="border-2 border-black px-5 py-2.5 hover:bg-black hover:text-white">GitHub</a>
        <a href={siteConfig.resumeUrl} class="border-2 border-black bg-black px-5 py-2.5 text-white hover:bg-white hover:text-black">Résumé</a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="flex items-center justify-between border-t-4 border-black pt-5 pb-10 font-meta text-sm font-bold tracking-[0.15em] uppercase">
      <span>No. 001</span>
      <div class="relative flex h-16 w-40 items-center justify-center">
        <img src="/images/seal-outline.png" alt="" class="absolute inset-0 h-full w-full" />
        <span class="font-accent text-base normal-case tracking-normal">portfolio</span>
      </div>
      <span>September 2026</span>
    </footer>
  </div>
</Layout>
