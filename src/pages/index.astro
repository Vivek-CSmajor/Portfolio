---
import { existsSync } from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GithubGraph from "../components/GithubGraph.astro";
import Icon from "../components/Icon.astro";
import TechIcon from "../components/TechIcon.astro";
import { siteConfig } from "../config/site.config";

// Tech Stack — ported from @Himanshu-19914's PR (#1): only categories with
// real downloadable logos get the icon-card grid; everything else rolls up
// into a single "Also in the mix" line below it.
const skills = [
  { label: "Languages", items: [{ name: "Go", icon: "go" }, { name: "C++", icon: "cplusplus" }] },
  { label: "Frameworks", items: [{ name: "Gin", icon: "gin" }, { name: "Django", icon: "django" }, { name: "FastAPI", icon: "fastapi" }] },
  { label: "Cloud / Infra", items: [{ name: "AWS", icon: "aws" }, { name: "GitHub Actions", icon: "githubactions" }, { name: "Git", icon: "git" }] },
];

// Get in Touch — ported from @Himanshu-19914's PR (#1).
const resumeAvailable =
  /^https:\/\//.test(siteConfig.resumeUrl) ||
  existsSync(path.join(process.cwd(), "public", siteConfig.resumeUrl.replace(/^\/+/, "")));
const resumeHref = resumeAvailable ? siteConfig.resumeUrl : `mailto:${siteConfig.email}?subject=Resume%20request`;
const contactLinks = [
  { label: "Email", href: `mailto:${siteConfig.email}`, icon: "mail" },
  { label: "LinkedIn", href: siteConfig.linkedinUrl, icon: "linkedin" },
  { label: "GitHub", href: siteConfig.githubUrl, icon: "github" },
  { label: resumeAvailable ? "Résumé" : "Request résumé", href: resumeHref, icon: "file" },
];

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    teaser: post.data.teaser,
    image: post.data.image,
    formattedDate: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
  }));
---

<Layout
  title="Vivek Pandey — Backend Developer"
  description="Backend developer working in Go and AWS on telephony, IoT, and voice AI systems."
>
  <div class="mx-auto max-w-6xl px-6 py-8 sm:px-10">
    <!-- Masthead -->
    <header class="flex flex-col items-center pt-4 pb-0 text-center">
      <h1 class="font-display text-6xl uppercase leading-[0.9] tracking-tight sm:text-8xl md:text-9xl">
        Vivek Pandey
      </h1>
    </header>

    <!-- Subhead banner -->
    <p class="mt-6 bg-black px-4 py-4 text-center font-headline text-lg uppercase tracking-wide text-white sm:text-2xl">
      Backend Developer — Go, AWS, and the Systems Underneath Telephony/VoIP
    </p>

    <!-- Lede + Tech Stack, side by side -->
    <section class="border-t-4 border-black py-12">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
            <div class="mx-auto aspect-[3/4] w-64 shrink-0 border-4 border-black sm:mx-0 sm:w-80">
              <img
                src="/images/mugshot.jpg"
                alt="Vivek Pandey mugshot-style portrait"
                class="h-full w-full object-cover grayscale"
              />
            </div>

            <p class="font-body text-2xl leading-snug">
              Currently a backend engineering intern at
              <span class="font-bold">Vobiz.ai</span>, working on core messaging
              infrastructure (SMS/RCS) and AI voice agent tooling for an AI-first
              telephony platform. CS undergrad at Amity University, Lucknow.
              <span class="font-bold">Language-agnostic by design</span> — Go is
              home base, but the interesting part is the systems, not the syntax.
            </p>
          </div>

          <p class="mt-8 inline-flex flex-wrap items-center gap-3 border-2 border-black px-4 py-2 font-meta text-sm font-bold tracking-[0.1em] uppercase">
            Bachelor's in Technology - Computer Science & Engineering · CGPA 8.3 · 2024–2028
          </p>
        </div>

        <div class="lg:col-span-4">
          <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">The Toolkit</p>
          <h2 class="mt-2 font-headline text-4xl uppercase leading-none sm:text-6xl">Tech Stack</h2>
          <p class="mt-4 max-w-2xl font-body text-lg">The tools I use to build APIs, cloud services, and the systems connecting them.</p>
          <div class="skills-grid mt-8 grid grid-cols-1 gap-8">
            {skills.map((group) => (
              <div class="skill-group">
                <h3 class="inline-block bg-black px-2 py-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white">
                  {group.label}
                </h3>
                <ul class="skill-items mt-4">
                  {group.items.map((skill) => <li><TechIcon slug={skill.icon} class="skill-logo" /><span>{skill.name}</span></li>)}
                </ul>
              </div>
            ))}
          </div>
          <p class="skills-extras font-body"><strong>Also in the mix:</strong> VoIP/SIP · REST APIs · Competitive Programming <span> / </span> Power BI · DAX · Power Query</p>
        </div>
      </div>
    </section>

    <!-- Featured work -->
    <section id="work" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Where I've Worked</p>
      <h2 class="mt-2 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        Internships
      </h2>

      <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-3">
        <article class="border-4 border-black">
          <div class="bg-black px-6 py-5 text-white">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
              Vobiz.ai
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
              Software Development Intern · May 2026 – Present
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug">
              Building core SMS/RCS messaging features in Go for an AI-first
              telephony platform; shipped a regression-testing microservice
              with CI/CD via GitHub Actions; prototyped noise-cancellation
              integrations to improve speech-to-text accuracy for AI voice
              agents (ElevenLabs, Vapi).
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Go · AWS · CI/CD · VoIP
            </p>
          </div>
        </article>

        <article class="border-4 border-black">
          <div class="bg-black px-6 py-5 text-white">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
              Devlume Software Solutions
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
              Software Development Intern · Sep – Dec 2025
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug">
              Backend feature development in Python (Django, FastAPI) and Go
              across two products — real-time industrial sensor ingestion on
              AWS IoT for a factory platform, plus VoIP/SIP monitoring
              integrations.
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Python · Django · FastAPI · Go · AWS IoT · SIP
            </p>
          </div>
        </article>

        <article class="border-4 border-black border-dashed">
          <div class="px-6 py-5">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight text-black/40">
              Third Internship
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-black/40">
              Company · Role · Dates
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug text-black/40">
              Tell me the company, role, dates, and what you actually did
              here and I'll drop it in.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Side Builds</p>
      <h2 class="mt-2 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
        Projects
      </h2>

      <div class="mt-8 grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <article class="border-4 border-black">
          <div class="bg-black px-6 py-5 text-white">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
              Offline Secure Coding Assessment Platform
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
              Personal Project · In Progress
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug">
              A hybrid cloud + LAN exam platform for universities to run
              placement rounds and lab exams fully offline — a cloud control
              plane paired with a local judging engine.
            </p>
            <ul class="mt-4 space-y-1.5 font-body text-base leading-snug">
              <li class="flex gap-3"><span class="font-headline">—</span> Sandboxed execution with ICPC-style scoring</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Local judging engine, no internet dependency mid-exam</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Lockdown-mode client — fullscreen and focus-switch enforcement</li>
            </ul>
            <a href="#" class="mt-4 inline-block border-b-2 border-black font-meta text-sm font-bold uppercase tracking-wide">
              View on GitHub &rarr;
            </a>
          </div>
        </article>

        <article class="border-4 border-black border-dashed">
          <div class="px-6 py-5">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight text-black/40">
              Project Name
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-black/40">
              Second Project
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug text-black/40">
              Tell me what this one is, what you built, and the stack, and
              I'll drop it in.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- GitHub activity -->
    <section id="activity" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">GitHub Activity</p>
      <h2 class="mt-2 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        Contribution Graph
      </h2>
      <div class="mt-8">
        <GithubGraph />
      </div>
    </section>

    <!-- Blog preview -->
    <section id="blog" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Writing</p>
      <h2 class="mt-2 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
        From the Blog
      </h2>
      <div class="mt-8 divide-y-2 divide-black">
        {posts.map((post) => (
          <article class="flex gap-6 py-6 first:pt-0">
            <div class="w-28 shrink-0 sm:w-36">
              {post.image ? (
                <img
                  src={post.image}
                  alt=""
                  class="aspect-square w-full border-2 border-black object-cover"
                />
              ) : (
                <div class="flex aspect-square w-full items-center justify-center border-2 border-black bg-black/5">
                  <p class="px-2 text-center font-meta text-[0.6rem] font-bold uppercase tracking-wide text-black/40">
                    Image
                  </p>
                </div>
              )}
            </div>
            <div class="flex-1">
              <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight sm:text-3xl">
                {post.title}
              </h3>
              <p class="mt-2 font-body text-lg leading-snug">
                {post.teaser}
              </p>
              <a
                href={`/blog/${post.slug}`}
                class="mt-3 inline-block border-b-2 border-black font-meta text-sm font-bold uppercase tracking-wide"
              >
                Read More &rarr;
              </a>
            </div>
            <p class="shrink-0 text-right font-meta text-xs font-bold uppercase tracking-[0.15em] text-black/60">
              {post.formattedDate}
            </p>
          </article>
        ))}
      </div>
      <a
        href="/blog"
        class="mt-8 inline-block border-2 border-black px-5 py-2.5 font-meta text-sm font-bold uppercase tracking-wide hover:bg-black hover:text-white"
      >
        View All Posts &rarr;
      </a>
    </section>
  </div>

  <!-- Get in Touch — ported from @Himanshu-19914's PR (#1), full-bleed. -->
  <div class="site-footer">
    <section id="contact" class="footer-contact" aria-labelledby="footer-contact-heading">
      <div class="footer-contact-intro">
        <p class="footer-label">GET IN TOUCH</p>
        <h2 id="footer-contact-heading" class="font-headline">LET'S BUILD<br />SOMETHING THAT WORKS.</h2>
        <p class="footer-contact-description font-body">An idea, a problem, or a hello — my inbox is open.</p>
      </div>
      <div class="footer-contact-details">
        <p class="footer-label">WRITE TO ME</p>
        <div class="footer-email-row">
          <a class="footer-email font-headline" href={`mailto:${siteConfig.email}`}>{siteConfig.email} <Icon name="arrow" /></a>
        </div>
        <button type="button" class="footer-copy-email" data-email={siteConfig.email} aria-label="Copy email address" hidden><span>COPY ADDRESS</span><Icon name="copy" /></button>
        <p class="footer-copy-status" role="status" aria-live="polite"></p>
        <div class="footer-contact-links">
          {contactLinks.map((link) => (
            <a href={link.href}><Icon name={link.icon} /><span>{link.label}</span><Icon name="arrow" /></a>
          ))}
        </div>
      </div>
    </section>
  </div>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>(".footer-copy-email");
    const copyStatus = document.querySelector<HTMLElement>(".footer-copy-status");
    if (copyButton && copyStatus && navigator.clipboard?.writeText) {
      copyButton.hidden = false;
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(copyButton.dataset.email ?? "");
          copyStatus.textContent = "Email address copied.";
        } catch {
          copyStatus.textContent = "Select the address above to copy it, or click it to write an email.";
        }
      });
    }
  </script>
</Layout>
