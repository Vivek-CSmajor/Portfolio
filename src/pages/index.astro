---
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GithubGraph from "../components/GithubGraph.astro";
import { siteConfig } from "../config/site.config";

const skills = [
  { label: "Languages", items: ["Go", "C++"] },
  { label: "Frameworks", items: ["Gin", "Django", "FastAPI"] },
  { label: "Cloud / Infra", items: ["AWS", "CI/CD (GitHub Actions)", "Git"] },
  { label: "Domain", items: ["VoIP/SIP", "REST APIs", "Competitive Programming"] },
  { label: "Data / BI", items: ["Power BI", "DAX", "Power Query"] },
];

// Inline monochrome icon SVGs (stroke="currentColor") so they recolor with
// the surrounding text — sized up to fill their block via width/height="100%".
function readIcon(name: string) {
  const raw = fs.readFileSync(path.join(process.cwd(), "public/icons", `${name}.svg`), "utf-8");
  return raw
    .replace(/<!--.*?-->/s, "")
    .replace('width="24"', 'width="100%"')
    .replace('height="24"', 'height="100%"');
}

const contactLinks = [
  { label: "Email", href: `mailto:${siteConfig.email}`, iconSrc: "/icons/email.png" },
  { label: "LinkedIn", href: siteConfig.linkedinUrl, iconSrc: "/icons/linkedin.png" },
  { label: "GitHub", href: siteConfig.githubUrl, iconSrc: "/icons/github-octocat.png" },
  { label: "Résumé", href: siteConfig.resumeUrl, iconSvg: readIcon("resume") },
];

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    teaser: post.data.teaser,
    formattedDate: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
  }));
---

<Layout
  title="Vivek Pandey — Backend Developer"
  description="Backend developer working in Go and AWS on telephony, IoT, and voice AI systems."
>
  <div class="mx-auto max-w-6xl px-6 py-8 sm:px-10">
    <!-- Masthead -->
    <header class="flex flex-col items-center pt-4 pb-0 text-center">
      <h1 class="font-display text-6xl uppercase leading-[0.9] tracking-tight sm:text-8xl md:text-9xl">
        Vivek Pandey
      </h1>
    </header>

    <!-- Subhead banner -->
    <p class="mt-6 bg-black px-4 py-4 text-center font-headline text-lg uppercase tracking-wide text-white sm:text-2xl">
      Backend Developer — Go, AWS, and the Systems Underneath Telephony/VoIP
    </p>

    <!-- Lede -->
    <section class="border-t-4 border-black py-12">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
        <div class="mx-auto aspect-square w-40 shrink-0 border-4 border-black bg-black/5 sm:mx-0 sm:w-48">
          <div class="flex h-full w-full items-center justify-center px-4 text-center font-meta text-xs font-bold uppercase tracking-wide text-black/50">
            Mugshot — drop your photo here
          </div>
        </div>

        <p class="font-body text-2xl leading-snug">
          Currently a backend engineering intern at
          <span class="font-bold">Vobiz.ai</span>, working on core messaging
          infrastructure (SMS/RCS) and AI voice agent tooling for an AI-first
          telephony platform. CS undergrad at Amity University, Lucknow.
          <span class="font-bold">Language-agnostic by design</span> — Go is
          home base, but the interesting part is the systems, not the syntax.
        </p>
      </div>

      <p class="mt-8 inline-flex flex-wrap items-center gap-3 border-2 border-black px-4 py-2 font-meta text-sm font-bold tracking-[0.1em] uppercase">
        Bachelor's in Technology - Computer Science & Engineering · CGPA 8.3 · 2024–2028
      </p>
    </section>

    <!-- Featured work -->
    <section id="work" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Where I've Worked</p>
      <h2 class="mt-2 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        Internships
      </h2>

      <div class="mt-10 grid grid-cols-1 items-start gap-8 lg:grid-cols-3">
        <article class="border-4 border-black">
          <div class="bg-black px-6 py-5 text-white">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
              Vobiz.ai
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
              Software Development Intern · May 2026 – Present
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug">
              Building core SMS/RCS messaging features in Go for an AI-first
              telephony platform; shipped a regression-testing microservice
              with CI/CD via GitHub Actions; prototyped noise-cancellation
              integrations to improve speech-to-text accuracy for AI voice
              agents (ElevenLabs, Vapi).
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Go · AWS · CI/CD · VoIP
            </p>
          </div>
        </article>

        <article class="border-4 border-black">
          <div class="bg-black px-6 py-5 text-white">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
              Devlume Software Solutions
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
              Software Development Intern · Sep – Dec 2025
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug">
              Backend feature development in Python (Django, FastAPI) and Go
              across two products — real-time industrial sensor ingestion on
              AWS IoT for a factory platform, plus VoIP/SIP monitoring
              integrations.
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Python · Django · FastAPI · Go · AWS IoT · SIP
            </p>
          </div>
        </article>

        <article class="border-4 border-black border-dashed">
          <div class="px-6 py-5">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight text-black/40">
              Third Internship
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-black/40">
              Company · Role · Dates
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-base leading-snug text-black/40">
              Tell me the company, role, dates, and what you actually did
              here and I'll drop it in.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Side Builds</p>
      <h2 class="mt-2 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
        Projects
      </h2>

      <div class="mt-8 grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <article class="border-2 border-black px-7 py-6">
          <p class="font-meta text-xs font-bold tracking-[0.2em] uppercase text-black/60">
            Personal Project — In Progress
          </p>
          <h3 class="mt-1 font-headline text-2xl uppercase leading-tight tracking-tight">
            Offline Secure Coding Assessment Platform
          </h3>
          <div class="mt-4 space-y-3 font-body text-base leading-snug">
            <p>
              A hybrid cloud + LAN exam platform for universities to run
              placement rounds and lab exams fully offline — a cloud control
              plane paired with a local judging engine.
            </p>
            <ul class="space-y-1.5">
              <li class="flex gap-3"><span class="font-headline">—</span> Sandboxed execution with ICPC-style scoring</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Local judging engine, no internet dependency mid-exam</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Lockdown-mode client — fullscreen and focus-switch enforcement</li>
            </ul>
          </div>
          <a href="#" class="mt-4 inline-block border-b-2 border-black font-meta text-sm font-bold uppercase tracking-wide">
            View on GitHub &rarr;
          </a>
        </article>

        <article class="border-2 border-black border-dashed px-7 py-6">
          <p class="font-meta text-xs font-bold tracking-[0.2em] uppercase text-black/40">
            Second Project
          </p>
          <h3 class="mt-1 font-headline text-2xl uppercase leading-tight tracking-tight text-black/40">
            Project Name
          </h3>
          <p class="mt-4 font-body text-base leading-snug text-black/40">
            Tell me what this one is, what you built, and the stack, and
            I'll drop it in.
          </p>
        </article>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Skills</p>
      <div class="mt-8 columns-1 gap-10 border-t-2 border-black pt-8 sm:columns-2 lg:columns-3">
        {skills.map((group) => (
          <div class="mb-8 break-inside-avoid border-l-4 border-black pl-4">
            <p class="inline-block bg-black px-2 py-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white">
              {group.label}
            </p>
            <p class="mt-2 font-body text-lg leading-snug">
              {group.items.join(" · ")}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- GitHub activity -->
    <section id="activity" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">GitHub Activity</p>
      <h2 class="mt-2 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        Contribution Graph
      </h2>
      <div class="mt-8">
        <GithubGraph />
      </div>
    </section>

    <!-- Blog preview -->
    <section id="blog" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">From the Blog</p>
      <div class="mt-6 divide-y-2 divide-black">
        {posts.map((post) => (
          <article class="flex gap-6 py-6 first:pt-0">
            <div class="w-28 shrink-0 sm:w-36">
              <p class="font-meta text-xs font-bold uppercase tracking-[0.15em] text-black/60">
                {post.formattedDate}
              </p>
              <div class="mt-2 flex aspect-square w-full items-center justify-center border-2 border-black bg-black/5">
                <p class="px-2 text-center font-meta text-[0.6rem] font-bold uppercase tracking-wide text-black/40">
                  Image
                </p>
              </div>
            </div>
            <div>
              <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight sm:text-3xl">
                {post.title}
              </h3>
              <p class="mt-2 font-body text-lg leading-snug">
                {post.teaser}
              </p>
              <a
                href={`/blog/${post.slug}`}
                class="mt-3 inline-block border-b-2 border-black font-meta text-sm font-bold uppercase tracking-wide"
              >
                Read More &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
      <a
        href="/blog"
        class="mt-8 inline-block border-2 border-black px-5 py-2.5 font-meta text-sm font-bold uppercase tracking-wide hover:bg-black hover:text-white"
      >
        View All Posts &rarr;
      </a>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t-4 border-black py-12">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Get in Touch</p>
          <h2 class="mt-3 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
            Let's talk backend systems, telephony, or otherwise.
          </h2>
        </div>

        <div class="lg:col-span-7">
          <div class="relative border-t-2 border-black">
            <span class="absolute -top-[5px] -left-[5px] h-[9px] w-[9px] bg-black"></span>
            <div class="grid grid-cols-2 gap-4 pt-6 sm:grid-cols-4">
              {contactLinks.map((link) => (
                <div class="flex flex-col items-center">
                  <span class="h-6 w-0.5 bg-black"></span>
                  <a href={link.href} class="group block w-full border-2 border-black">
                    <div class="flex h-14 items-center justify-center border-b-2 border-black bg-black text-white">
                      {link.iconSvg && <div class="h-5 w-5" set:html={link.iconSvg} />}
                      {link.iconSrc && (
                        <img src={link.iconSrc} alt="" class="h-5 w-5 object-contain invert" />
                      )}
                    </div>
                    <p class="px-2 py-2.5 text-center font-meta text-sm font-bold uppercase tracking-wide group-hover:bg-black group-hover:text-white">
                      {link.label}
                    </p>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
