---
import { existsSync } from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GithubGraph from "../components/GithubGraph.astro";
import BlogPostRow from "../components/BlogPostRow.astro";
import Icon from "../components/Icon.astro";
import TechIcon from "../components/TechIcon.astro";
import { siteConfig } from "../config/site.config";

// Tech Stack — ported from @Himanshu-19914's PR (#1): only categories with
// real downloadable logos get the icon-card grid; everything else rolls up
// into a single "Also in the mix" line below it.
const skills = [
  { label: "Languages", items: [{ name: "Go", icon: "go" }, { name: "C++", icon: "cplusplus" }] },
  { label: "Frameworks", items: [{ name: "Gin", icon: "gin" }, { name: "Django", icon: "django" }, { name: "FastAPI", icon: "fastapi" }] },
  { label: "Cloud / Infra", items: [{ name: "AWS", icon: "aws" }, { name: "GitHub Actions", icon: "githubactions" }, { name: "Git", icon: "git" }] },
  { label: "Monitoring", items: [{ name: "Datadog", icon: "datadog" }] },
];

// Get in Touch — ported from @Himanshu-19914's PR (#1).
const resumeAvailable =
  /^https:\/\//.test(siteConfig.resumeUrl) ||
  existsSync(path.join(process.cwd(), "public", siteConfig.resumeUrl.replace(/^\/+/, "")));
const resumeHref = resumeAvailable ? siteConfig.resumeUrl : `mailto:${siteConfig.email}?subject=Resume%20request`;
const contactLinks = [
  { label: "Instagram", href: siteConfig.instagramUrl, icon: "instagram" },
  { label: "LinkedIn", href: siteConfig.linkedinUrl, icon: "linkedin" },
  { label: "GitHub", href: siteConfig.githubUrl, icon: "github" },
  { label: resumeAvailable ? "Résumé" : "Request résumé", href: resumeHref, icon: "file", download: resumeAvailable ? "Vivek Pandey - Resume.pdf" : undefined },
];

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    teaser: post.data.teaser,
    image: post.data.image,
    formattedDate: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
  }));
---

<Layout
  title="Vivek Pandey — Backend Developer"
  description="Backend developer working in Go and AWS on telephony, IoT, and voice AI systems."
>
  <div class="mx-auto max-w-6xl px-6 py-8 sm:px-10">
    <!-- Masthead -->
    <header class="flex flex-col items-center pt-4 pb-0 text-center">
      <h1 class="font-display text-6xl uppercase leading-[0.9] tracking-tight sm:text-8xl md:text-9xl">
        Vivek Pandey
      </h1>
    </header>

    <!-- Subhead banner -->
    <p class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 bg-black px-4 py-4 text-center font-headline text-sm uppercase tracking-wide text-white sm:text-xl">
      <a href={siteConfig.githubUrl} class="inline-flex items-center gap-1.5 hover:underline underline-offset-4"><Icon name="github" class="h-4 w-4 sm:h-5 sm:w-5" />GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={siteConfig.leetcodeUrl} class="inline-flex items-center gap-1.5 hover:underline underline-offset-4"><Icon name="leetcode" class="h-4 w-4 sm:h-5 sm:w-5" />LeetCode</a>
      <span aria-hidden="true">·</span>
      <a href="/#blog" class="inline-flex items-center gap-1.5 hover:underline underline-offset-4"><Icon name="pencil" class="h-4 w-4 sm:h-5 sm:w-5" />Blogs</a>
      <span aria-hidden="true">·</span>
      <a href={siteConfig.linkedinUrl} class="inline-flex items-center gap-1.5 hover:underline underline-offset-4"><Icon name="linkedin" class="h-4 w-4 sm:h-5 sm:w-5" />LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href={resumeHref} download={resumeAvailable ? "Vivek Pandey - Resume.pdf" : undefined} class="inline-flex items-center gap-1.5 hover:underline underline-offset-4"><Icon name="file" class="h-4 w-4 sm:h-5 sm:w-5" />Resume</a>
      <span aria-hidden="true">·</span>
      <a href="#contact" class="inline-flex items-center gap-1.5 hover:underline underline-offset-4"><Icon name="contact" class="h-4 w-4 sm:h-5 sm:w-5" />Contacts</a>
    </p>

    <!-- Lede + Tech Stack, side by side -->
    <section class="border-t-4 border-black py-12">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
            <div class="mx-auto w-64 shrink-0 sm:mx-0 sm:w-80">
              <div class="aspect-[3/4] border-4 border-black">
                <img
                  src="/images/mugshot.jpg"
                  alt="Vivek Pandey mugshot-style portrait"
                  class="h-full w-full object-cover grayscale"
                />
              </div>
              <p class="mt-4 border-2 border-black px-3 py-2 text-center font-meta text-xs font-bold uppercase tracking-[0.1em]">
                B.Tech Computer Science & Engineering<br />CGPA 8.3 · 2024–2028
              </p>
            </div>

            <p class="font-body text-2xl leading-snug">
              CS undergrad and backend engineer with production-grade experience
              in AI voice systems, CRM software, and IoT platforms, built through
              internships — currently at Vobiz.ai.
              Language-agnostic, though the Golang beaver is my man. I care about DSA
              beyond the interview grind. Currently I'm exploring distributed
              systems and OSS, and I prefer to write
              minimal code that works, stays clean, and is actually mine
              — not AI-generated, unless it's frontend design, in which case,
              I am the ultimate vibecoder.
            </p>
          </div>

          <div id="activity" class="mt-8">
            <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">GitHub Activity</p>
            <h2 class="mt-2 flex items-center gap-3 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
              <img src="/icons/github-octocat.png" alt="" aria-hidden="true" class="h-8 w-8 shrink-0 object-contain sm:h-10 sm:w-10" />
              Contribution Graph
            </h2>
            <div class="mt-8">
              <GithubGraph />
            </div>
          </div>
        </div>

        <div class="lg:col-span-4">
          <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">The Toolkit</p>
          <h2 class="mt-2 font-headline text-4xl uppercase leading-none sm:text-6xl">Tech Stack</h2>
          <div class="skills-grid mt-8 grid grid-cols-1 gap-8">
            {skills.map((group) => (
              <div class="skill-group">
                <h3 class="inline-block bg-black px-2 py-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white">
                  {group.label}
                </h3>
                <ul class="skill-items mt-4">
                  {group.items.map((skill) => <li><TechIcon slug={skill.icon} class="skill-logo" /><span>{skill.name}</span></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Featured work -->
    <section id="work" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Where I've Worked</p>
      <h2 class="mt-2 font-headline text-4xl uppercase leading-[0.95] tracking-tight sm:text-6xl">
        Internships
      </h2>

      <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <article class="border-4 border-black lg:col-span-2">
          <div class="flex items-center justify-between gap-4 bg-black px-6 py-5 text-white">
            <div>
              <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
                Vobiz.ai
              </h3>
              <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
                Software Development Intern · May 2026 – Present
              </p>
            </div>
            <img
              src="/images/logos/devlume-mark.svg"
              alt="Vobiz.ai"
              class="h-6 w-auto shrink-0 grayscale invert"
            />
          </div>
          <div class="px-6 py-6">
            <ul class="space-y-1.5 font-body text-xl leading-snug">
              <li class="flex gap-3"><span class="font-headline">—</span> Cut S3 storage costs by 97.7% — from lakhs per month to a few hundred rupees — by overhauling retention and storage practices across 30+ EC2 instances.</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Built core SMS/RCS messaging features in Go for a SIP trunking platform, supporting large-scale AI conversations between voice agents and chatbots.</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Designed a call recording retention and custom billing system handling 5M+ calls a day.</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Diagnosed and fixed bugs across the platform's backend services, improving stability and reliability.</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Designed and built a regression-testing suite microservice in Go, deployed automatically via CI/CD pipelines using GitHub Actions.</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Created a microservice to monitor carrier health and report via a Slack bot in monitoring channels.</li>
            </ul>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Go · AWS · CI/CD · VoIP
            </p>
          </div>
        </article>

        <article class="border-4 border-black">
          <div class="flex items-center justify-between gap-4 bg-black px-6 py-5 text-white">
            <div>
              <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
                Devlume Software Solutions
              </h3>
              <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
                Software Development Intern · Sep – Dec 2025
              </p>
            </div>
            <img
              src="/images/logos/vobiz-mark.svg"
              alt="Devlume Software Solutions"
              class="h-6 w-auto shrink-0 invert"
            />
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-xl leading-snug">
              Backend feature development in Python (Django, FastAPI) and Go
              across two products — real-time industrial sensor ingestion on
              AWS IoT for a factory platform, plus VoIP/SIP monitoring
              integrations.
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Python · Django · FastAPI · Go · AWS IoT · SIP
            </p>
          </div>
        </article>

        <article class="border-4 border-black">
          <div class="flex items-center justify-between gap-4 bg-black px-6 py-5 text-white">
            <div>
              <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
                In-Sync
              </h3>
              <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
                Power BI Developer Intern · Gurgaon, India · May – Sep 2024
              </p>
            </div>
            <img
              src="/images/logos/insync-mark.png"
              alt="In-Sync"
              class="h-14 w-14 shrink-0 object-contain grayscale"
            />
          </div>
          <div class="px-6 py-6">
            <ul class="space-y-1.5 font-body text-xl leading-snug">
              <li class="flex gap-3"><span class="font-headline">—</span> Designed and built interactive Power BI dashboards using DAX and Power Query for data transformation, modeling, and business reporting.</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Delivered reporting solutions for enterprise clients including Audi Kolkata, Ezeepay, Rupeeboss, and Quess Corp.</li>
            </ul>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Power BI · DAX · Power Query
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Side Builds</p>
      <h2 class="mt-2 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
        Projects
      </h2>

      <div class="mt-8 grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <article class="border-4 border-black">
          <div class="bg-black px-6 py-5 text-white">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
              Offline Secure Coding Assessment Platform
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
              Personal Project · In Progress
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-xl leading-snug">
              A hybrid cloud + LAN exam platform for universities to run
              placement rounds and lab exams fully offline — a cloud control
              plane paired with a local judging engine.
            </p>
            <ul class="mt-4 space-y-1.5 font-body text-xl leading-snug">
              <li class="flex gap-3"><span class="font-headline">—</span> Sandboxed execution with ICPC-style scoring</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Local judging engine, no internet dependency mid-exam</li>
              <li class="flex gap-3"><span class="font-headline">—</span> Lockdown-mode client — fullscreen and focus-switch enforcement</li>
            </ul>
            <a href="https://github.com/Vivek-CSmajor/CampusCode-Server" class="mt-4 inline-block border-b-2 border-black font-meta text-sm font-bold uppercase tracking-wide">
              View on GitHub &rarr;
            </a>
          </div>
        </article>

        <article class="border-4 border-black">
          <div class="bg-black px-6 py-5 text-white">
            <h3 class="font-headline text-xl uppercase leading-tight tracking-tight">
              Relational Database From Scratch
            </h3>
            <p class="mt-1 font-meta text-xs font-bold uppercase tracking-[0.15em] text-white/70">
              Personal Project · Planned · Not Started
            </p>
          </div>
          <div class="px-6 py-6">
            <p class="font-body text-xl leading-snug">
              Planning a relational database built from scratch in Go —
              B-tree storage engine, WAL, and MVCC, with QUIC and SQL parsing
              as the only borrowed pieces. Building it to actually understand
              the distributed-systems internals behind the infra everyone
              leans on right now — etcd, eBPF, Cilium, CockroachDB — instead
              of just using it.
            </p>
            <p class="mt-4 font-meta text-xs font-bold uppercase tracking-wide text-black">
              Go · B-Tree · WAL · MVCC · QUIC · SQL
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- GitHub activity -->

    <!-- Blog preview -->
    <section id="blog" class="border-t-4 border-black py-12">
      <p class="font-meta text-sm font-bold tracking-[0.2em] uppercase">Writing</p>
      <h2 class="mt-2 font-headline text-3xl uppercase leading-[0.95] tracking-tight sm:text-5xl">
        From the Blog
      </h2>
      <div class="mt-8 divide-y-2 divide-black">
        {posts.map((post, i) => <BlogPostRow {...post} isFirst={i === 0} />)}
        <article class="flex flex-col gap-4 py-6 sm:flex-row sm:items-start sm:gap-6">
          <div class="flex items-start justify-between gap-4 sm:contents">
            <div class="w-28 shrink-0 sm:w-36">
              <div class="flex aspect-square w-full items-center justify-center border-2 border-black border-dashed bg-black/5">
                <p class="px-2 text-center font-meta text-[0.6rem] font-bold uppercase tracking-wide text-black/40">
                  Image
                </p>
              </div>
            </div>
            <p class="shrink-0 text-right font-meta text-xs font-bold uppercase tracking-[0.15em] text-black/40 sm:order-3">
              Coming Soon
            </p>
          </div>
          <div class="flex-1">
            <h3 class="font-headline text-2xl uppercase leading-tight tracking-tight text-black/40 sm:text-3xl">
              Next Post
            </h3>
            <p class="mt-2 font-body text-xl leading-snug text-black/40">
              Tell me what you want written up next and I'll draft it.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>

  <!-- Get in Touch — ported from @Himanshu-19914's PR (#1), full-bleed. -->
  <div class="site-footer">
    <section id="contact" class="footer-contact" aria-labelledby="footer-contact-heading">
      <div class="footer-contact-intro">
        <p class="footer-label">GET IN TOUCH</p>
        <h2 id="footer-contact-heading" class="font-headline">FIND ME<br />I ALWAYS REPLY.</h2>
        <img
          src="/images/find-me-i-always-reply.gif"
          alt="Rachel from Friends waving and saying 'I'm gonna go'"
          class="mt-6 w-full max-w-[390px] border-4 border-white grayscale"
        />
      </div>
      <div class="footer-contact-details">
        <p class="footer-label">WRITE TO ME</p>
        <div class="footer-email-row">
          <a class="footer-email font-headline" href={`mailto:${siteConfig.email}`}>{siteConfig.email} <Icon name="arrow" /></a>
        </div>
        <button type="button" class="footer-copy-email" data-email={siteConfig.email} aria-label="Copy email address" hidden><span>COPY ADDRESS</span><Icon name="copy" /></button>
        <p class="footer-copy-status" role="status" aria-live="polite"></p>
        <p class="footer-phone font-headline">{siteConfig.phone}</p>
        <div class="footer-contact-links">
          {contactLinks.map((link) => (
            <a href={link.href} download={link.download}><Icon name={link.icon} /><span>{link.label}</span><Icon name="arrow" /></a>
          ))}
        </div>
      </div>
    </section>
  </div>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>(".footer-copy-email");
    const copyStatus = document.querySelector<HTMLElement>(".footer-copy-status");
    if (copyButton && copyStatus && navigator.clipboard?.writeText) {
      copyButton.hidden = false;
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(copyButton.dataset.email ?? "");
          copyStatus.textContent = "Email address copied.";
        } catch {
          copyStatus.textContent = "Select the address above to copy it, or click it to write an email.";
        }
      });
    }
  </script>
</Layout>
